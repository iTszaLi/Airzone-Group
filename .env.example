# Airzone Group — environment variables (copy to your hosting provider's settings).
# Never commit real values. Only VITE_* variables reach the browser bundle.

# --- Website (artifacts/airzone-group) ---
# Optional GA4 measurement ID (G-XXXXXXX). Analytics loads only after visitor consent.
VITE_GA4_MEASUREMENT_ID=
# Show the "Admin access" link in the footer ("true") only once the admin sign-in (Clerk) works on the site.
VITE_SHOW_ADMIN_LINK=
# Optional base path if not served from the domain root (default "/").
BASE_PATH=/
# Port for `pnpm --filter @workspace/airzone-group run serve` (production web server).
PORT=21365
# Set to "true" only after reviewing Content-Security-Policy report-only output.
CSP_ENFORCE=
# Set to "true" only after HTTPS is verified on airzonegroup.com (Node server only; Vercel sends HSTS itself).
ENABLE_HSTS=
# Vercel only (read at build time): region(s) for the API function, e.g. fra1, next to the database.
# See docs/DEPLOY-VERCEL.md, which also covers ENABLE_EXPERIMENTAL_COREPACK=1 for pinning pnpm.
VERCEL_API_REGIONS=
# Search engine verification and indexing (read at build time; values are public tokens, not secrets).
# Google Search Console HTML-tag token (content value only), emitted on the homepage:
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools msvalidate.01 token (content value only), emitted on the homepage:
BING_SITE_VERIFICATION=
# IndexNow key (8-128 letters, digits or hyphens). The build publishes /<key>.txt; after a deploy run
# pnpm --filter @workspace/airzone-group run indexnow -- --confirm   to notify Bing and other IndexNow engines.
INDEXNOW_KEY=

# --- API server (artifacts/api-server) — stores enquiries and shipment tracking ---
# PostgreSQL connection string (required for forms, tracking and admin).
DATABASE_URL=
# Clerk keys for the admin workspace (server-side only).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Comma-separated list of extra origins allowed to call the API with credentials.
# Leave empty when the website and /api share one origin (recommended).
ALLOWED_ORIGINS=
LOG_LEVEL=info

# --- Email notifications (API server only; never exposed to the browser) ---
# Travel enquiries, logistics quotation requests and fleet vehicle requests are always stored
# in the database. They are also emailed to the right team when BOTH of these are set:
# API key from https://resend.com (server secret; keep it in the host's secrets store).
RESEND_API_KEY=
# Sender on a domain verified in Resend, e.g. "Airzone Logistics <quotes@airzonegroup.com>".
EMAIL_FROM=
# Recipients, comma-separated (server-side only; requests cannot change them). Empty = default.
# Travel quotation requests (default Ticketing@airzonetravel.net):
TRAVEL_QUOTE_EMAIL=
# Logistics quotation requests from the quote and specialist logistics forms (default info@envodkingdom.net):
LOGISTICS_QUOTE_EMAIL=
# Fleet vehicle requests (default LOGISTICS_QUOTE_EMAIL, then info@envodkingdom.net):
FLEET_QUOTE_EMAIL=
# Contact and callback forms go to the travel or logistics inbox by the department chosen;
# "General Enquiry" goes here (default LOGISTICS_QUOTE_EMAIL, then info@envodkingdom.net):
GENERAL_ENQUIRY_EMAIL=
# Testing only: send to a local mock instead of Resend. Leave unset in production.
# EMAIL_API_URL=http://127.0.0.1:8090/emails

# Local testing only: forward /api from the website dev/preview server to the API server
# API_PROXY_TARGET=http://127.0.0.1:8080
